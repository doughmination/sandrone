# Discord bot token — required. The bot won't start without it.
# Create an application at https://discord.com/developers/applications
# and copy the token from the "Bot" tab.
BOT_TOKEN=

# Command prefix for legacy (non-slash) commands. Defaults to "!".
BOT_PREFIX=!

# Set to "true" to enable development mode. Defaults to "false".
DEV_MODE=false

# GitHub personal access token — optional. Only needed for the /github command.
# The github cog is skipped if this is unset.
# Create one at https://github.com/settings/tokens/new
GITHUB_TOKEN=

# Where /yt-dlp puts files too big to attach to a Discord message.
# Defaults to a "downloads" folder in the repo root.
DOWNLOADS_DIR=

# Interface and port the built-in download server listens on.
DOWNLOADS_HOST=0.0.0.0
DOWNLOADS_PORT=2020

# Public base URL the download links point at. Set this to whatever your
# reverse proxy exposes DOWNLOADS_PORT as, e.g. https://files.example.com
# Defaults to http://localhost:<DOWNLOADS_PORT>.
DOWNLOADS_URL=

# How long a hosted download stays on disk before the sweep deletes it.
DOWNLOADS_RETENTION_HOURS=24

# Refuse any single download larger than this, so one 4K pull can't fill
# the disk. In MiB.
DOWNLOADS_MAX_SIZE_MIB=2048
