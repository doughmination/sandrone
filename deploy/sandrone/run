#!/bin/sh
# runit service for Sandrone.
# Adjust these to match where the bot lives on the server.
SANDRONE_DIR=/srv/clove/sandrone
SANDRONE_USER=clove

exec 2>&1

cd "$SANDRONE_DIR" || exit 1

# runit starts services with a minimal environment: chpst doesn't set HOME,
# and uv, yt-dlp and argostranslate all keep their caches there.
export HOME="$(getent passwd "$SANDRONE_USER" | cut -d: -f6)"
export PATH=/usr/local/bin:/usr/bin:/bin
export PYTHONUNBUFFERED=1

# uv syncs the venv from uv.lock before starting, so a git pull plus
# 'sv restart sandrone' is enough to pick up dependency changes.
exec chpst -u "$SANDRONE_USER" uv run --frozen --no-dev python -m sandrone
