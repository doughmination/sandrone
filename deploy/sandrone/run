#!/bin/sh
# deploy/sandrone/run
# runit service for Sandrone. Adjust these to match where the bot lives.
SANDRONE_DIR=/srv/bot/sandrone
SANDRONE_USER=clove

exec 2>&1

cd "$SANDRONE_DIR" || exit 1

# runit starts services with a minimal environment: chpst doesn't set HOME,
# and Deno and yt-dlp keep their caches there.
export HOME="$(getent passwd "$SANDRONE_USER" | cut -d: -f6)"
export PATH="$HOME/.deno/bin:/usr/local/bin:/usr/bin:/bin"
export NO_COLOR=1

# deno install pulls anything new from deno.lock before starting, so a
# git pull plus 'sv restart sandrone' is enough to pick up dependency changes.
chpst -u "$SANDRONE_USER" deno install --frozen || exit 1
exec chpst -u "$SANDRONE_USER" deno task start
